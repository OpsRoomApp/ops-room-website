# Public website environment configuration
# Copy this file to .env and update values as needed.

# Feature flag for future payment features.
VITE_PAYMENT_ENABLED=false

# Umami tracker website id, baked into the JS bundle at build time (Vite
# build arg on the opsroom-website service). Empty = no tracker in the
# build. Set this after creating the opsroom.live website in Umami, then
# rebuild the website container: docker compose build opsroom-website.
VITE_UMAMI_WEBSITE_ID=

# Stripe publishable key (public, used by the frontend).
VITE_STRIPE_PUBLIC_KEY=

# Server-side only: never expose these in the frontend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Admin Panel (admin.opsroom.live) ----

# GitHub OAuth App credentials.
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL: https://admin.opsroom.live
# Callback URL: https://admin.opsroom.live/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Redirect URI must match the GitHub OAuth App callback URL exactly.
GITHUB_REDIRECT_URI=https://admin.opsroom.live/api/auth/callback

# Comma-separated list of GitHub usernames permitted to access the admin panel.
# Example: APPROVED_GITHUB_USERS=octocat,opsroom-admin
APPROVED_GITHUB_USERS=

# Secret key for signing JWT session tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Salt for hashing download analytics IP addresses.
# If not set, falls back to JWT_SECRET. Analytics are silently disabled if
# the salt equals "change-me" (the default placeholder).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYTICS_SALT=

# Optional: JWT session expiry in hours (default 8).
# JWT_EXPIRY_HOURS=8

# Optional: maximum upload size in MB (default 500).
# MAX_UPLOAD_MB=500

# Optional: rate limiting (per-minute per-IP).
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_UPLOAD_PER_MIN=5

# Optional: download analytics retention in days (default 90).
# ANALYTICS_RETENTION_DAYS=90

# ---- Discord OAuth (C3) ----
# Create an OAuth2 application at https://discord.com/developers/applications
# with the 'identify' scope and add a redirect URI matching DISCORD_REDIRECT_URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://admin.opsroom.live/api/auth/discord/callback

# Comma-separated list of Discord user IDs permitted to access the admin panel.
# Example: APPROVED_DISCORD_USERS=123456789012345678,987654321098765432
APPROVED_DISCORD_USERS=

# ---- End-user Discord app-connect (community flights) ----
# Separate redirect for the desktop app "Connect Discord" flow. MUST be
# registered verbatim in the Discord Developer Portal (OAuth2 > Redirects).
DISCORD_APP_CONNECT_REDIRECT_URI=https://admin.opsroom.live/api/community/connect/callback
# Optional ops/testing bypass for community event ingestion. When set, a bearer
# header matching this token lets the caller supply discord_id directly. The
# desktop app uses per-user app_tokens from the connect flow and never needs it.
COMMUNITY_EVENT_TOKEN=

# ---- Hosted ticket transcripts (B1/C1) ----
# How many days a public transcript link stays valid before auto-expiry.
TRANSCRIPT_RETENTION_DAYS=14
# Shared bearer token the Discord bot uses to POST closed-ticket transcripts.
# Must match ADMIN_API_TOKEN in the bot .env.
ADMIN_API_TOKEN=

# ---- FAA NMS-API NOTAM proxy (v0.25.60) ----
# Credentials from the NMS-API onboarding spreadsheet (KEY = client id, SECRET = client secret).
# These live ONLY on the VPS -- the desktop app and Discord bot talk to
# https://opsroom.live/api/v1/nms/ with the shared NMS_API_TOKEN and never
# see these values.
NMS_CLIENT_KEY=
NMS_CLIENT_SECRET=
# fit | staging | production (default staging while test access is active).
NMS_ENVIRONMENT=staging
# Optional explicit override (only set this when migrating environments):
# NMS_BASE_URL=https://api-nms.aim.faa.gov
# Shared token that gates the proxy so it is not an open relay.
# Falls back to ADMIN_API_TOKEN when unset.
NMS_API_TOKEN=

# ---- NOTAM ingest-to-DB pipeline (v0.25.63) ----
# The server keeps a SQLite copy of the FAA NMS NOTAM set (1 bulk pull / 24h
# + 1 incremental pull / 3 min) so per-airport requests from the app, bot and
# Live Map cost ZERO FAA quota. DB path is wired in docker-compose.yml
# (/opt/opsroom-notams/notams.db); override only for local development.
# NOTAMS_DB_PATH=/opt/opsroom-notams/notams.db
# Set 0 to disable the background ingestion jobs (e.g. local dev).
NMS_INGEST_ENABLED=1
# Optional single classification for the 3-minute incremental pull. Leave
# empty to ingest all classifications in one pull (recommended).
# NOTAM_CLASSIFICATION=

# ---- OpenSky realworld-search proxy (Live Map online traffic) ----
# The desktop app's Live Map online traffic uses OpenSky; the credentials
# live ONLY on the VPS, like the NMS/OpenAIP keys.
# Get them at https://openskynetwork.github.io/opensky-api/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ---- OpenAIP airspace proxy (map enrichment) ----
# The desktop app calls https://opsroom.live/api/v1/openaip/airspaces for
# airspace polygons; the key lives ONLY on the VPS, like the NMS/OpenSky keys.
# Get a key at https://www.openaip.net (free tier is fine for map views).
OPENAIP_API_KEY=
# Optional: shared token that gates the endpoint. The desktop sends it
# automatically when configured. When unset the endpoint is public HTTPS
# (matching the OpenSky realworld-search proxy).
# OPENAIP_PROXY_TOKEN=

# ---- OPS CONTROL bot database (Discord admin endpoints) ----
# Optional path to the bot SQLite DB for the Discord operations console.
# OPS_CONTROL_DB=/opt/ops-control-bot/data/ops-control.db

# ---- RainViewer precipitation proxy (v0.25.80) ----
# Server-side tile cache for the Live Map precipitation layer. The
# folder is mounted into the admin-api container at the same path.
RAINVIEWER_CACHE_DIR=/opt/opsroom-rainviewer

# ---- Bug report ingest (v0.25.80) ----
# The desktop app's in-app Report Bug posts to
# https://admin.opsroom.live/api/v1/bug-reports (SQLite + diagnostics ZIP
# storage, admin panel under Bug Reports). All vars are optional -- the
# compose defaults are safe and match the value shipped in the desktop
# binary. Rotate BUG_REPORT_SECRET only together with a new desktop build.
# BUG_REPORT_SECRET=e7eb1adf7e094220a3f5ad89fcf6d01ce4194a0fe4b2452f9415b97d808bbbab
# BUG_REPORTS_DB=/opt/opsroom-bug-reports/bug_reports.sqlite3
# BUG_REPORTS_STORAGE_DIR=/opt/opsroom-bug-reports
# BUG_REPORTS_RATE_LIMIT_PER_MIN=10

# ---- Website support form (v0.25.x) ----
# Public contact form on opsroom.live/support. No secret (public by design);
# per-IP rate limiting is the primary spam defense. Messages appear in the
# admin panel under Support Requests.
# SUPPORT_DB=/opt/opsroom-support/support.sqlite3
# SUPPORT_RATE_LIMIT_PER_MIN=5

# ---- Umami website analytics (v0.25.x, self-hosted) ----
# Cookieless, GDPR-friendly analytics. Runs as two containers (umami +
# postgres) on the VPS; the tracker loads same-origin from opsroom.live
# and the admin panel Analytics page reads stats through the admin-api
# bridge (UMAMI_API_URL points at the umami container on the docker net).
#
# First-run setup (one time, after the containers are up):
#   1. Create the Umami admin account. Either open the setup page via an
#      SSH tunnel (ssh -L 3000:127.0.0.1:3000 user@VPS then browse to
#      http://localhost:3000) or run once on the VPS:
#        curl -X POST http://127.0.0.1:3000/api/auth/setup -H 'Content-Type: application/json' \
#          -d '{"name":"Ops Room","username":"<you>","password":"<strong-password>"}'
#   2. Create the opsroom.live website in the Umami dashboard and copy its
#      website id into UMAMI_WEBSITE_ID below.
#   3. Put the account from step 1 into UMAMI_USERNAME / UMAMI_PASSWORD
#      and the website id into UMAMI_WEBSITE_ID (admin-api bridge) AND
#      into VITE_UMAMI_WEBSITE_ID (tracker, baked in at build time).
UMAMI_API_URL=http://umami:3000
UMAMI_USERNAME=
UMAMI_PASSWORD=
UMAMI_WEBSITE_ID=
# Secret for Umami session cookies + hashing. Generate a random string:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
UMAMI_APP_SECRET=
# Postgres password for the umami database (also used by the umami app).
UMAMI_DB_PASSWORD=

# ---- flightsim.to social-proof badge (v0.25.x) ----
# Rating/download badge on the homepage. Two sources, live API preferred:
#
# 1) LIVE (needs a developer API key from flightsim.to):
# FLIGHTSIM_API_KEY=
# FLIGHTSIM_ADDON_ID=111241
# FLIGHTSIM_ADDON_URL=https://flightsim.to/addon/111241/ops-room-operations-command-centre-public-beta
# FLIGHTSIM_STATS_URL=https://api.flightsim.to/v1/modules/{addon_id}
#
# 2) MANUAL (no key needed): static numbers until the live API is wired up.
#    Set at least one; the badge shows real figures either way. Current
#    values as of 2026-08-14: 4.9 rating, 7 reviews, 485 downloads.
# FLIGHTSIM_MANUAL_RATING=4.9
# FLIGHTSIM_MANUAL_RATING_COUNT=7
# FLIGHTSIM_MANUAL_DOWNLOADS=485
#
# When neither source is configured the badge falls back to a plain
# "Available on flightsim.to" link (never a broken widget).

# ---- Discord release notifications (v0.25.x) ----
# Incoming webhooks fired from the admin panel publish action, the instant a
# release goes live. No bot permissions or polling needed.
#
# #release-notes (1522225470089855146): formatted release note embed.
DISCORD_RELEASE_WEBHOOK_URL=
# #downloads (1522225534514499724): direct installer + ZIP + page links.
DISCORD_DOWNLOADS_WEBHOOK_URL=
#
# Create each webhook in Discord (channel settings -> Integrations -> Webhooks)
# and paste the full URL here. Empty URL = that channel's post is disabled.
