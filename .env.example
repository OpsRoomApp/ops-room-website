# Public website environment configuration
# Copy this file to .env and update values as needed.

# Feature flag for future payment features.
VITE_PAYMENT_ENABLED=false

# Stripe publishable key (public, used by the frontend).
VITE_STRIPE_PUBLIC_KEY=

# Server-side only: never expose these in the frontend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Admin Panel (admin.opsroom.live) ----

# GitHub OAuth App credentials.
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL: https://admin.opsroom.live
# Callback URL: https://admin.opsroom.live/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Redirect URI must match the GitHub OAuth App callback URL exactly.
GITHUB_REDIRECT_URI=https://admin.opsroom.live/api/auth/callback

# Comma-separated list of GitHub usernames permitted to access the admin panel.
# Example: APPROVED_GITHUB_USERS=octocat,opsroom-admin
APPROVED_GITHUB_USERS=

# Secret key for signing JWT session tokens.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=

# Salt for hashing download analytics IP addresses.
# If not set, falls back to JWT_SECRET. Analytics are silently disabled if
# the salt equals "change-me" (the default placeholder).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
ANALYTICS_SALT=

# Optional: JWT session expiry in hours (default 8).
# JWT_EXPIRY_HOURS=8

# Optional: maximum upload size in MB (default 500).
# MAX_UPLOAD_MB=500

# Optional: rate limiting (per-minute per-IP).
# RATE_LIMIT_LOGIN_PER_MIN=10
# RATE_LIMIT_UPLOAD_PER_MIN=5

# Optional: download analytics retention in days (default 90).
# ANALYTICS_RETENTION_DAYS=90

# ---- Discord OAuth (C3) ----
# Create an OAuth2 application at https://discord.com/developers/applications
# with the 'identify' scope and add a redirect URI matching DISCORD_REDIRECT_URI.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://admin.opsroom.live/api/auth/discord/callback

# Comma-separated list of Discord user IDs permitted to access the admin panel.
# Example: APPROVED_DISCORD_USERS=123456789012345678,987654321098765432
APPROVED_DISCORD_USERS=

# ---- Hosted ticket transcripts (B1/C1) ----
# How many days a public transcript link stays valid before auto-expiry.
TRANSCRIPT_RETENTION_DAYS=14
# Shared bearer token the Discord bot uses to POST closed-ticket transcripts.
# Must match ADMIN_API_TOKEN in the bot .env.
ADMIN_API_TOKEN=

# ---- FAA NMS-API NOTAM proxy (v0.25.60) ----
# Credentials from the NMS-API onboarding spreadsheet (KEY = client id, SECRET = client secret).
# These live ONLY on the VPS -- the desktop app and Discord bot talk to
# https://opsroom.live/api/v1/nms/ with the shared NMS_API_TOKEN and never
# see these values.
NMS_CLIENT_KEY=
NMS_CLIENT_SECRET=
# fit | staging | production (default staging while test access is active).
NMS_ENVIRONMENT=staging
# Optional explicit override (only set this when migrating environments):
# NMS_BASE_URL=https://api-nms.aim.faa.gov
# Shared token that gates the proxy so it is not an open relay.
# Falls back to ADMIN_API_TOKEN when unset.
NMS_API_TOKEN=

# ---- OpenAIP airspace proxy (map enrichment) ----
# The desktop app calls https://opsroom.live/api/v1/openaip/airspaces for
# airspace polygons; the key lives ONLY on the VPS, like the NMS/OpenSky keys.
# Get a key at https://www.openaip.net (free tier is fine for map views).
OPENAIP_API_KEY=
# Optional: shared token that gates the endpoint. The desktop sends it
# automatically when configured. When unset the endpoint is public HTTPS
# (matching the OpenSky realworld-search proxy).
# OPENAIP_PROXY_TOKEN=

# ---- OPS CONTROL bot database (Discord admin endpoints) ----
# Optional path to the bot SQLite DB for the Discord operations console.
# OPS_CONTROL_DB=/opt/ops-control-bot/data/ops-control.db
